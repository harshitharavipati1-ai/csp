PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/crop_cycle_db
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173

# Set both values to create the initial admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional demo data. Leave disabled for normal/production deployments.
SEED_DEMO_DATA=false
DEMO_FARMER_EMAIL=farmer@example.com
DEMO_FARMER_PASSWORD=
